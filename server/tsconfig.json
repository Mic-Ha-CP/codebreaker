{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "..",
    "paths": {
      "shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "scripts", "../shared"]
}
